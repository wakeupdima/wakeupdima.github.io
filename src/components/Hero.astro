---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import HeroBackground from './HeroBackground.astro';
import portrait from '../assets/home/portrait.png';
import { contacts } from '../data/site';

const socials = [
  { ...contacts.telegram, icon: 'telegram', external: true },
  { ...contacts.behance, icon: 'behance', external: true },
  { ...contacts.email, icon: 'gmail', external: false },
];
---

<section class="hero" aria-labelledby="hero-title">
  <HeroBackground />

  <div class="container hero__row">
    <div class="hero__intro">
      <h1 class="t-intro hero__title" id="hero-title">Hi there! I’m Dmytro Zaichenko.</h1>
      <p class="hero__line">I’m a UI/UX designer based in Kyiv. I work on web and mobile products, from research to UI.</p>
      <ul class="hero__socials">
        {socials.map((s) => (
          <li>
            <a
              class="icon-btn icon-btn--lg"
              href={s.href}
              aria-label={s.external ? `${s.label} (opens in a new tab)` : s.label}
              {...(s.external ? { target: '_blank', rel: 'noopener' } : {})}
            >
              <Icon name={s.icon} />
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="hero__photo">
      <Image
        src={portrait}
        alt="Portrait of Dmytro Zaichenko"
        width={380}
        height={460}
        densities={[1, 2]}
        loading="eager"
      />
    </div>
  </div>

  <a class="hero__scroll t-label" href="#work">Scroll ↓</a>
</section>

<!-- Runs before paint: lock the mobile hero to the screen height at load.
     Updated only when the width changes (rotation), not when the toolbar hides on scroll. -->
<script is:inline>
  (function () {
    var root = document.documentElement;
    var lastW = 0;
    function lock() {
      var w = window.innerWidth;
      if (w === lastW) return;
      lastW = w;
      root.style.setProperty('--hero-h', window.innerHeight + 'px');
    }
    lock();
    window.addEventListener('resize', lock);
  })();
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 720px;
    display: flex;
    flex-direction: column;
    background: var(--color-hero-ink);
    color: var(--color-white);
    overflow: hidden;
  }

  .hero__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    margin-top: 148px;
    min-height: 460px;
  }

  .hero__intro { max-width: 780px; }
  .hero__title { color: var(--color-white); }
  .hero__line {
    max-width: 500px;
    margin-top: var(--space-4);
    font-size: 22px;
    line-height: 32px;
    color: var(--color-surface);
  }
  .hero__socials {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .hero__photo {
    flex: none;
    width: 380px;
    height: 460px;
    padding: 6px;
    border-radius: var(--radius-lg);
    background: var(--color-white);
  }
  .hero__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 7px;
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: var(--space-6);
    translate: -50% 0;
    display: grid;
    place-items: center;
    width: 104px;
    height: 32px;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-hero-ink) 70%, transparent);
    color: var(--color-white);
    transition: background-color var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }
  .hero__scroll:hover { background: var(--color-hero-ink); }
  .hero__scroll:focus-visible { box-shadow: 0 0 0 2px var(--color-white); }

  /* Tablet: same layout, smaller portrait */
  @media (max-width: 1199px) {
    .hero__photo { width: 300px; height: 364px; }
  }

  /* Mobile: centered stack — small photo on top, then greeting, line and socials */
  @media (max-width: 767px) {
    /* Height of the first screen, fixed once by the inline script below.
       100svh as a fallback; it changes when the browser toolbar shows/hides in some
       browsers (in-app webviews), which made the hero resize and stutter while scrolling. */
    .hero { min-height: var(--hero-h, 100svh); }
    .hero__row {
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: var(--space-8);
      flex: 1;
      min-height: 0;
      margin-top: 0;
      padding: 104px 0 88px;
      text-align: center;
    }
    .hero__photo {
      order: -1;
      width: 200px;
      height: auto;
      aspect-ratio: 380 / 460;
      padding: 4px;
    }
    .hero__photo :global(img) { border-radius: var(--radius-md); }
    .hero__intro {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .hero__line {
      max-width: 340px;
      font-size: 18px;
      line-height: 28px;
      text-wrap: balance;
    }
    .hero__socials { margin-top: var(--space-6); }
  }

  /* Small phones: keep the first screen from overflowing */
  @media (max-width: 767px) and (max-height: 700px) {
    .hero__row { padding-top: 88px; gap: var(--space-6); }
    .hero__photo { width: 160px; }
  }
</style>
