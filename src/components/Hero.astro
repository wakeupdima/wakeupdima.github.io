---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import heroBg from '../assets/home/hero-bg.png';
import portrait from '../assets/home/portrait.png';
import { contacts } from '../data/site';

const socials = [
  { ...contacts.telegram, icon: 'telegram', external: true },
  { ...contacts.behance, icon: 'behance', external: true },
  { ...contacts.email, icon: 'gmail', external: false },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true">
    <!-- Pixel art: served as the original PNG (smaller than WebP and no smoothing artefacts) -->
    <img
      src={heroBg.src}
      alt=""
      width={heroBg.width}
      height={heroBg.height}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="hero__img"
    />
    <div class="hero__scrim hero__scrim--left"></div>
    <div class="hero__scrim hero__scrim--edges"></div>
  </div>


  <div class="container hero__row">
    <div class="hero__intro">
      <h1 class="t-intro hero__title" id="hero-title">Hi there! I’m Dmytro Zaichenko.</h1>
      <p class="hero__line">I’m a UI/UX designer based in Kyiv. I work on web and mobile products, from research to UI.</p>
      <ul class="hero__socials">
        {socials.map((s) => (
          <li>
            <a
              class="icon-btn icon-btn--lg"
              href={s.href}
              aria-label={s.external ? `${s.label} (opens in a new tab)` : s.label}
              {...(s.external ? { target: '_blank', rel: 'noopener' } : {})}
            >
              <Icon name={s.icon} />
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="hero__photo">
      <Image
        src={portrait}
        alt="Portrait of Dmytro Zaichenko"
        width={380}
        height={460}
        densities={[1, 2]}
        loading="eager"
      />
    </div>
  </div>

  <a class="hero__scroll t-label" href="#work">Scroll ↓</a>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 720px;
    display: flex;
    flex-direction: column;
    background: var(--color-hero-ink);
    color: var(--color-white);
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__img {
    position: absolute;
    left: 0;
    top: -90px;
    width: 100%;
    height: calc(100% + 180px);
    max-width: none;
    object-fit: cover;
    object-position: center;
    image-rendering: pixelated;
  }
  .hero__scrim { position: absolute; inset: 0; }
  .hero__scrim--left {
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--color-hero-ink) 90%, transparent) 0%,
      color-mix(in srgb, var(--color-hero-ink) 82%, transparent) 45%,
      color-mix(in srgb, var(--color-hero-ink) 30%, transparent) 66%,
      color-mix(in srgb, var(--color-hero-ink) 0%, transparent) 80%
    );
  }
  .hero__scrim--edges {
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-hero-ink) 55%, transparent) 0%,
      color-mix(in srgb, var(--color-hero-ink) 0%, transparent) 18%,
      color-mix(in srgb, var(--color-hero-ink) 0%, transparent) 80%,
      color-mix(in srgb, var(--color-hero-ink) 60%, transparent) 100%
    );
  }

  .hero__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    margin-top: 148px;
    min-height: 460px;
  }

  .hero__intro { max-width: 780px; }
  .hero__title { color: var(--color-white); }
  .hero__line {
    max-width: 500px;
    margin-top: var(--space-4);
    font-size: 22px;
    line-height: 32px;
    color: var(--color-surface);
  }
  .hero__socials {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .hero__photo {
    flex: none;
    width: 380px;
    height: 460px;
    padding: 6px;
    border-radius: var(--radius-lg);
    background: var(--color-white);
  }
  .hero__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 7px;
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: var(--space-6);
    translate: -50% 0;
    display: grid;
    place-items: center;
    width: 104px;
    height: 32px;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-hero-ink) 70%, transparent);
    color: var(--color-white);
    transition: background-color var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }
  .hero__scroll:hover { background: var(--color-hero-ink); }
  .hero__scroll:focus-visible { box-shadow: 0 0 0 2px var(--color-white); }

  /* Tablet: same layout, smaller portrait */
  @media (max-width: 1199px) {
    .hero__photo { width: 300px; height: 364px; }
  }

  /* Mobile: text first, portrait below, full scrim */
  @media (max-width: 767px) {
    .hero { min-height: 100svh; }
    .hero__scrim--left { background: color-mix(in srgb, var(--color-hero-ink) 75%, transparent); }
    .hero__row {
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: var(--space-12);
      flex: 1;
      min-height: 0;
      margin-top: 0;
      padding: 112px 0 88px;
    }
    .hero__line { font-size: 18px; line-height: 28px; }
    .hero__photo { width: 280px; height: 340px; }
  }
</style>
