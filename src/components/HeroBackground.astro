---
/**
 * Hero background: the dithered landscape, brought to life.
 *
 * The static PNG is always rendered first (and is the only thing shown with
 * prefers-reduced-motion, without WebGL, or if anything fails). On top of it a
 * WebGL canvas redraws the scene every frame: it distorts a smooth "tone" version
 * of the picture (clouds billow, wind runs through the grass, light drifts) and
 * dithers it again into the same 6 colors on the same 2×2 px grid.
 */
import heroBg from '../assets/home/hero-bg.png';
import heroTone from '../assets/home/hero-tone.png';
---

<div class="hero-bg" aria-hidden="true">
  <!-- Pixel art: served as the original PNG (smaller than WebP and no smoothing artefacts) -->
  <img
    src={heroBg.src}
    alt=""
    width={heroBg.width}
    height={heroBg.height}
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="hero-bg__layer hero-bg__img"
  />
  <canvas class="hero-bg__layer hero-bg__canvas" data-hero-canvas data-tone={heroTone.src}></canvas>
  <div class="hero-bg__scrim hero-bg__scrim--left"></div>
  <div class="hero-bg__scrim hero-bg__scrim--edges"></div>
</div>

<style>
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  /* Image and canvas share one box: shifted up 90px, extra 180px tall, cover */
  .hero-bg__layer {
    position: absolute;
    left: 0;
    top: -90px;
    width: 100%;
    height: calc(100% + 180px);
    max-width: none;
  }
  .hero-bg__img {
    object-fit: cover;
    object-position: center;
    image-rendering: pixelated;
  }
  .hero-bg__canvas {
    display: block;
    image-rendering: pixelated;
    opacity: 0;
    transition: opacity 800ms var(--ease-out);
  }
  .hero-bg__canvas.is-ready { opacity: 1; }

  .hero-bg__scrim { position: absolute; inset: 0; }
  .hero-bg__scrim--left {
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--color-hero-ink) 90%, transparent) 0%,
      color-mix(in srgb, var(--color-hero-ink) 82%, transparent) 45%,
      color-mix(in srgb, var(--color-hero-ink) 30%, transparent) 66%,
      color-mix(in srgb, var(--color-hero-ink) 0%, transparent) 80%
    );
  }
  .hero-bg__scrim--edges {
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-hero-ink) 55%, transparent) 0%,
      color-mix(in srgb, var(--color-hero-ink) 0%, transparent) 18%,
      color-mix(in srgb, var(--color-hero-ink) 0%, transparent) 80%,
      color-mix(in srgb, var(--color-hero-ink) 60%, transparent) 100%
    );
  }

  @media (max-width: 767px) {
    .hero-bg__scrim--left { background: color-mix(in srgb, var(--color-hero-ink) 75%, transparent); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bg__canvas { display: none; }
  }
</style>

<script>
  const IMAGE_W = 1440;
  const IMAGE_H = 900;
  const CELL = 2; // one dither cell = 2×2 CSS px, as in the source image
  // Keep it light: slow motion looks right at a low frame rate (and pixel art suits it)
  const lowEnd =
    (navigator.hardwareConcurrency ?? 8) <= 4 ||
    ((navigator as Navigator & { deviceMemory?: number }).deviceMemory ?? 8) <= 4;
  const FPS = lowEnd ? 15 : 24;
  const MAX_CELLS = 1100 * 620; // cap pixels per frame on very large screens

  const VERT = `
    attribute vec2 aPos;
    void main() { gl_Position = vec4(aPos, 0.0, 1.0); }
  `;

  // Palette, dark → light: the 6 colors of hero-bg.png (see scripts/make-hero-tone.mjs)
  const FRAG = `
    precision mediump float;
    uniform sampler2D uTone;
    uniform vec2 uRes;    // canvas size in pixels (= dither cells)
    uniform vec2 uView;   // visible part of the image (object-fit: cover)
    uniform float uTime;

    float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
    float noise(vec2 p) {
      vec2 i = floor(p), f = fract(p);
      vec2 u = f * f * (3.0 - 2.0 * f);
      return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), u.x),
                 mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x), u.y);
    }
    float fbm(vec2 p) {
      float v = 0.0, a = 0.5;
      for (int i = 0; i < 3; i++) { v += a * noise(p); p *= 2.03; a *= 0.5; }
      return v;
    }
    // Ordered (Bayer 4×4) threshold, 0…1
    float bayer2(vec2 a) { a = floor(a); return fract(dot(a, vec2(0.5, a.y * 0.75))); }
    float bayer4(vec2 a) { return bayer2(0.5 * a) * 0.25 + bayer2(a); }

    vec3 palette(float i) {
      if (i < 0.5) return vec3(2.0, 12.0, 54.0) / 255.0;
      if (i < 1.5) return vec3(20.0, 36.0, 85.0) / 255.0;
      if (i < 2.5) return vec3(38.0, 60.0, 115.0) / 255.0;
      if (i < 3.5) return vec3(57.0, 84.0, 147.0) / 255.0;
      if (i < 4.5) return vec3(75.0, 109.0, 178.0) / 255.0;
      return vec3(244.0, 244.0, 242.0) / 255.0;
    }

    void main() {
      vec2 p = gl_FragCoord.xy / uRes;
      p.y = 1.0 - p.y;
      vec2 uv = 0.5 + (p - 0.5) * uView;   // position in the source image, 0…1
      float t = uTime;

      // Regions of the picture (image space): sky with clouds, valley, grass field
      float sky = 1.0 - smoothstep(0.34, 0.47, uv.y);
      float field = smoothstep(0.58, 0.74, uv.y);
      float near = smoothstep(0.6, 1.0, uv.y);   // wind is stronger closer to the viewer

      vec2 d = vec2(0.0);
      float extra = 0.0;   // added to the blue tone
      float glint = 0.0;   // added to the white-dot density

      // Noise is only computed where something moves (the valley stays still)
      if (sky > 0.0) {
        // Clouds slowly billow, light drifts over them
        vec2 c = uv * vec2(3.0, 5.0);
        d += (vec2(fbm(c + vec2(t * 0.05, 0.0)), fbm(c + vec2(5.2, 1.3) - vec2(0.0, t * 0.035))) - 0.5)
             * vec2(0.016, 0.011) * sky;
        float light = fbm(uv * 2.2 + vec2(t * 0.03, t * 0.012)) - 0.5;
        extra += light * 0.14 * sky;
        glint += light * 1.6 * sky;   // scaled by the local highlight below
      }
      if (field > 0.0) {
        // Wind through the grass: blades lean as waves travel across; lighter gusts sweep over
        float sway = noise(uv * vec2(3.0, 8.0) + vec2(t * 0.25, 0.0));
        float wave = sin(uv.x * 14.0 - t * 1.4 + sway * 5.0);
        d.x += wave * 0.0065 * near * field;
        d.y += (0.5 + 0.5 * wave) * 0.0025 * near * field;
        float g = fbm(vec2(uv.x * 2.2 - t * 0.18, uv.y * 7.0 + t * 0.04));
        float gust = smoothstep(0.52, 0.78, g) * field;
        extra += gust * 0.2;
        glint += gust;          // scaled by the local highlight below
      }

      vec2 src = texture2D(uTone, uv + d).rg;
      float threshold = bayer4(gl_FragCoord.xy) + 0.03125;

      // Dither the blue tone into the 5 blue shades…
      float level = clamp(src.r + extra, 0.0, 1.0) * 4.0;
      float base = floor(level);
      float idx = base + step(threshold, level - base);
      // …and put white dots on top where the highlight density is high enough
      // Highlights only grow or fade where the picture already has them (cloud edges, lit grass)
      float white = src.g * (1.0 + glint) + glint * 0.12 * smoothstep(0.8, 1.0, src.r);
      if (white > 1.0 - threshold) idx = 5.0;

      gl_FragColor = vec4(palette(idx), 1.0);
    }
  `;

  function start(canvas: HTMLCanvasElement) {
    const gl = canvas.getContext('webgl', {
      alpha: false,
      antialias: false,
      depth: false,
      stencil: false,
      preserveDrawingBuffer: false,
      powerPreference: 'low-power',
    });
    if (!gl) return;

    const compile = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(s) ?? 'shader');
      return s;
    };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, compile(gl.VERTEX_SHADER, VERT));
    gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, FRAG));
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(prog) ?? 'link');
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const aPos = gl.getAttribLocation(prog, 'aPos');
    gl.enableVertexAttribArray(aPos);
    gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);

    const uRes = gl.getUniformLocation(prog, 'uRes');
    const uView = gl.getUniformLocation(prog, 'uView');
    const uTime = gl.getUniformLocation(prog, 'uTime');

    let visible = true;
    let ready = false;
    let raf = 0;
    let last = 0;
    const t0 = performance.now();

    function resize() {
      const r = canvas.getBoundingClientRect();
      if (!r.width || !r.height) return;
      let cell = CELL;
      while ((r.width / cell) * (r.height / cell) > MAX_CELLS) cell += 0.5;
      canvas.width = Math.max(1, Math.round(r.width / cell));
      canvas.height = Math.max(1, Math.round(r.height / cell));
      gl!.viewport(0, 0, canvas.width, canvas.height);
      const s = Math.max(r.width / IMAGE_W, r.height / IMAGE_H);
      gl!.uniform2f(uRes, canvas.width, canvas.height);
      gl!.uniform2f(uView, r.width / s / IMAGE_W, r.height / s / IMAGE_H);
    }

    function frame(now: number) {
      raf = requestAnimationFrame(frame);
      if (now - last < 1000 / FPS - 2) return;
      last = now;
      gl!.uniform1f(uTime, (now - t0) / 1000);
      gl!.drawArrays(gl!.TRIANGLES, 0, 3);
      if (!ready) {
        ready = true;
        canvas.classList.add('is-ready');
      }
    }

    function update() {
      const run = visible && document.visibilityState === 'visible' && texReady;
      if (run && !raf) raf = requestAnimationFrame(frame);
      if (!run && raf) {
        cancelAnimationFrame(raf);
        raf = 0;
      }
    }

    // Tone texture
    let texReady = false;
    const tex = gl.createTexture();
    const img = new Image();
    img.decoding = 'async';
    img.onload = () => {
      gl.bindTexture(gl.TEXTURE_2D, tex);
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, img);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
      texReady = true;
      resize();
      update();
    };
    img.src = canvas.dataset.tone!;

    new ResizeObserver(resize).observe(canvas);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      update();
    }).observe(canvas.closest('section') ?? canvas);
    document.addEventListener('visibilitychange', update);

    canvas.addEventListener('webglcontextlost', (e) => {
      e.preventDefault();
      cancelAnimationFrame(raf);
      raf = 0;
      texReady = false;
      canvas.classList.remove('is-ready');
    });
  }

  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (canvas && !reduced.matches) {
    try {
      start(canvas);
    } catch {
      // Keep the static image
      canvas.remove();
    }
  }
</script>
