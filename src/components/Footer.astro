---
import { url } from '../lib/url';
import { contacts, resumeHref } from '../data/site';
import { projects } from '../data/projects';

const columns = [
  {
    title: 'Navigation',
    links: [
      { label: 'Work', href: url('/#work') },
      { label: 'About', href: url('/about') },
    ],
  },
  {
    title: 'Contact',
    links: [
      { label: 'Telegram', href: contacts.telegram.href, external: true },
      { label: 'Behance', href: contacts.behance.href, external: true },
      { label: 'Email', href: contacts.email.href },
      { label: 'GitHub', href: contacts.github.href, external: true },
      { label: 'Resume', href: url(resumeHref), external: true },
    ],
  },
  {
    title: 'Case studies',
    links: projects.map((p) => ({ label: p.name, href: url(`/work/${p.slug}`) })),
  },
] as { title: string; links: { label: string; href: string; external?: boolean }[] }[];
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__cols">
      {columns.map((col) => (
        <section class="footer__col" aria-labelledby={`footer-${col.title.toLowerCase().replace(' ', '-')}`}>
          <h2 class="t-h3 footer__title" id={`footer-${col.title.toLowerCase().replace(' ', '-')}`}>{col.title}</h2>
          <ul class="footer__links">
            {col.links.map((link) => (
              <li>
                <a
                  class="text-link text-link--on-dark footer__link"
                  href={link.href}
                  {...(link.external ? { target: '_blank', rel: 'noopener' } : {})}
                >
                  {link.label}
                  {link.external && <span class="visually-hidden"> (opens in a new tab)</span>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
    <div class="footer__bottom">
      <p>© 2026 Dmytro Zaichenko</p>
      <p>Designed and built in Kyiv</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-secondary);
    color: var(--color-white);
    padding: var(--space-24) 0 var(--space-12);
  }
  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: 112px;
  }
  .footer__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 320px));
    gap: 40px;
    padding-left: 80px;
  }
  .footer__title { color: var(--color-white); }
  .footer__links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-top: var(--space-6);
  }
  .footer__link {
    display: inline-block;
    padding-block: 7px;
    font-size: 18px;
    line-height: 26px;
  }
  .footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    color: color-mix(in srgb, var(--color-white) 75%, transparent);
  }

  @media (max-width: 1199px) {
    .footer__cols { padding-left: 0; }
  }
  @media (max-width: 767px) {
    .footer { padding-top: var(--space-16); }
    .footer__inner { gap: var(--space-16); }
    .footer__cols { grid-template-columns: 1fr; gap: var(--space-12); }
    .footer__links { margin-top: var(--space-3); }
    .footer__link { padding-block: 9px; }
    .footer__bottom { flex-direction: column; gap: var(--space-2); }
  }
</style>
