---
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/geist-mono/400.css';
import '@fontsource/geist-mono/600.css';
import '../styles/tokens.css';
import '../styles/base.css';

import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Footer from '../components/Footer.astro';
import ContactDialog from '../components/ContactDialog.astro';
import { site } from '../data/site';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  /** Social preview image; defaults to public/og.jpg */
  ogImage?: ImageMetadata;
  ogType?: 'website' | 'article';
}

const { title = site.title, description = site.description, ogImage, ogType = 'website' } = Astro.props;

const siteUrl = Astro.site ?? new URL('https://wakeupdima.github.io');
// Clean URL (no .html), matching how the site links to its pages
const pageUrl = new URL(Astro.url.pathname.replace(/(index)?\.html$/, ''), siteUrl).href;

let ogSrc = url('/og.jpg');
let ogWidth = 1200;
let ogHeight = 630;
if (ogImage) {
  const img = await getImage({ src: ogImage, width: 1200, format: 'jpg', quality: 82 });
  ogSrc = img.src;
  ogWidth = Number(img.attributes.width ?? 1200);
  ogHeight = Number(img.attributes.height ?? Math.round((1200 / ogImage.width) * ogImage.height));
}
const ogUrl = new URL(ogSrc, siteUrl).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta name="theme-color" content="#0D1846" />

    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Dmytro Zaichenko" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content={String(ogWidth)} />
    <meta property="og:image:height" content={String(ogHeight)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot name="header" />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <ContactDialog />
  </body>
</html>

<style>
  main:focus { outline: none; }
</style>
