---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import CaseContents from '../../components/CaseContents.astro';
import CaseSection from '../../components/CaseSection.astro';
import { cases, nextCase, type CaseStudy } from '../../data/cases';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return cases.map((c) => ({ params: { slug: c.slug }, props: { study: c } }));
}

interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;
const next = nextCase(study.slug);
---

<BaseLayout
  title={`${study.title} — Dmytro Zaichenko`}
  description={study.subtitle}
  ogImage={study.cover.src}
  ogType="article"
>
  <Nav slot="header" />

  <article class="case">
    <header class="container case-hero" id="top">
      <div class="case-hero__head">
        <h1 class="t-display">{study.title}</h1>
        <p class="case-hero__subtitle">{study.subtitle}</p>
      </div>

      <dl class="case-meta" style={`--cols: ${study.meta.length}`}>
        {study.meta.map((m) => (
          <div class="case-meta__item">
            <dt class="t-label">{m.label}</dt>
            <dd>
              {m.value.map((line, i) => (
                <>
                  {i > 0 && <br />}
                  {line}
                </>
              ))}
            </dd>
          </div>
        ))}
      </dl>

      <Image
        src={study.cover.src}
        alt={study.cover.alt}
        widths={[600, 1200, 1800, 2400]}
        sizes="(max-width: 1279px) calc(100vw - 40px), 1200px"
        loading="eager"
        fetchpriority="high"
        class="case-hero__cover"
      />
    </header>

    <div class="container case-body">
      <div class="case-body__aside">
        <CaseContents sections={study.sections} />
      </div>
      <div class="case-body__content">
        {study.sections.map((section) => <CaseSection section={section} />)}
      </div>
    </div>

    <footer class="container case-end">
      <h2 class="case-end__title">Thank you for checking out this project!</h2>
      <a class="btn btn--secondary" href={url(`/work/${next.slug}`)}>Next project: {next.title} →</a>
    </footer>
  </article>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .case-hero {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding: var(--space-24) 0 var(--space-16);
  }
  .case-hero__subtitle {
    margin-top: var(--space-4);
    font-size: 24px;
    line-height: 32px;
    color: var(--color-secondary);
  }

  .case-meta {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: var(--space-6) var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-line);
  }
  .case-meta dt { color: var(--color-secondary); }
  .case-meta dd {
    margin-top: var(--space-2);
    font-size: 16px;
    line-height: 26px;
    color: var(--color-primary);
  }

  .case-hero :global(.case-hero__cover) {
    width: 100%;
    border: 1px solid var(--color-line);
    border-radius: 16px;
  }

  /* ---------- Body ---------- */
  .case-body {
    display: grid;
    grid-template-columns: 240px minmax(0, 900px);
    justify-content: space-between;
    gap: 60px;
    padding: var(--space-16) 0 var(--space-24);
  }
  .case-body__content {
    display: flex;
    flex-direction: column;
    gap: 120px;
    min-width: 0;
  }

  /* ---------- End ---------- */
  .case-end {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-12) 0 120px;
    text-align: center;
  }
  .case-end__title {
    font-size: 32px;
    line-height: 36px;
    letter-spacing: -0.02em;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 1199px) {
    .case-body { grid-template-columns: 200px minmax(0, 1fr); gap: 48px; }
  }

  @media (max-width: 1023px) {
    .case-body { grid-template-columns: minmax(0, 1fr); }
    .case-body__aside { display: none; }
    .case-meta { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    /* An odd last item (Tools / Deliverables) gets the full row so its lines don't break mid-phrase */
    .case-meta__item:last-child:nth-child(odd) { grid-column: 1 / -1; }
  }

  @media (max-width: 767px) {
    .case-hero { gap: var(--space-8); padding: var(--space-16) 0 var(--space-12); }
    .case-hero__subtitle { font-size: 20px; line-height: 28px; margin-top: var(--space-3); }
    .case-hero :global(.case-hero__cover) { border-radius: var(--radius-lg); }
    .case-body { padding: var(--space-8) 0 var(--space-16); }
    .case-body__content { gap: 72px; }
    .case-end { padding: var(--space-8) 0 var(--space-16); }
    .case-end__title { font-size: 24px; line-height: 30px; }
  }
</style>
